# Leave blank to disable Zenoh status publishing.
ZENOH_ENDPOINT=
ZENOH_KEY_PREFIX=smolvla
CPU_TEMP_PATH=/sys/class/thermal/thermal_zone0/temp

# ROS 2 / rmw_zenoh defaults used by container.sh and compose.yaml.
OMY_IP=172.16.101.221
ZENOH_PORT=7447
ROS_DOMAIN_ID=30
RMW_IMPLEMENTATION=rmw_zenoh_cpp
ZENOH_CONFIG_OVERRIDE=mode="client";connect/endpoints=["tcp/172.16.101.221:7447"]

# Raspberry Pi with rmw_zenohd listening on the host:
# ZENOH_ENDPOINT=tcp/host.docker.internal:7447
